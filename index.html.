<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LearnNexus - Login & Registration</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

    body {
      background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container { width: 100%; max-width: 420px; }

    .logo { text-align: center; margin-bottom: 30px; }
    .logo h1 { font-size: 32px; color: #ffffff; letter-spacing: 2px; }
    .logo h1 span { color: #4da6ff; }
    .logo p { color: #a0a0a0; font-size: 14px; margin-top: 5px; }

    /* Shared Styles */
    h2 { color: #ffffff; margin-bottom: 5px; text-align: center; }
    .subtitle { color: #a0a0a0; text-align: center; font-size: 14px; margin-bottom: 25px; }

    .input-group { margin-bottom: 18px; }
    .input-group label { display: block; color: #cccccc; font-size: 13px; margin-bottom: 6px; }
    .input-group input, .input-group select {
      width: 100%;
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      transition: border-color 0.3s;
    }
    .input-group input:focus, .input-group select:focus { border-color: #4da6ff; }
    .input-group input::placeholder { color: #666666; }
    .input-group select option { background: #24243e; color: #ffffff; }

    .password-wrapper { position: relative; }
    .password-wrapper input { padding-right: 45px; }
    .toggle-password {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      font-size: 16px;
      padding: 5px;
    }

    .show-password {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #a0a0a0;
      font-size: 12px;
      margin-top: 8px;
      cursor: pointer;
    }
    .show-password input { width: auto; cursor: pointer; }

    .btn-primary {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #4da6ff, #2b6cb0);
      border: none;
      border-radius: 8px;
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.3s, transform 0.2s;
    }
    .btn-primary:hover { opacity: 0.9; transform: translateY(-2px); }
    .btn-primary:active { transform: translateY(0); }

    .divider {
      display: flex;
      align-items: center;
      margin: 20px 0;
      color: #666666;
      font-size: 12px;
    }
    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
    }
    .divider span { padding: 0 12px; }

    .link-text {
      text-align: center;
      color: #a0a0a0;
      font-size: 13px;
      margin-top: 15px;
    }
    .link-text a {
      color: #4da6ff;
      text-decoration: none;
      font-weight: 600;
      cursor: pointer;
    }
    .link-text a:hover { text-decoration: underline; }

    .back-link {
      display: block;
      text-align: center;
      color: #666666;
      font-size: 12px;
      text-decoration: none;
      margin-top: 18px;
      cursor: pointer;
      transition: color 0.3s;
    }
    .back-link:hover { color: #4da6ff; }

    /* Role Selection */
    .role-card {
      display: flex;
      align-items: center;
      gap: 15px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 18px 20px;
      margin-bottom: 15px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .role-card:hover {
      background: rgba(77, 166, 255, 0.15);
      border-color: #4da6ff;
      transform: translateX(5px);
    }
    .role-icon { font-size: 32px; }
    .role-info h3 { color: #ffffff; font-size: 16px; margin-bottom: 3px; }
    .role-info p { color: #a0a0a0; font-size: 12px; }

    /* Box */
    .box {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 30px;
    }

    .selected-role {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(77, 166, 255, 0.2);
      border: 1px solid #4da6ff;
      border-radius: 20px;
      padding: 6px 16px;
      margin-bottom: 20px;
      color: #4da6ff;
      font-size: 13px;
    }

    .terms {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #a0a0a0;
      font-size: 12px;
      margin-bottom: 18px;
      cursor: pointer;
    }
    .terms input { width: auto; cursor: pointer; }
    .terms a { color: #4da6ff; text-decoration: none; }
    .terms a:hover { text-decoration: underline; }

    .footer-text {
      text-align: center;
      color: #444444;
      font-size: 11px;
      margin-top: 25px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">
      <h1>LEARN<span>NEXUS</span></h1>
      <p id="subtitleText">Learning Management System</p>
    </div>

    <!-- PAGE 1: ROLE SELECTION -->
    <div id="page-role">
      <h2>Select Your Role</h2>
      <p class="subtitle">Choose how you want to sign in</p>

      <div class="role-card" onclick="goToLogin('student')">
        <div class="role-icon">🎓</div>
        <div class="role-info">
          <h3>Student</h3>
          <p>Access courses, assignments, and grades</p>
        </div>
      </div>

      <div class="role-card" onclick="goToLogin('teacher')">
        <div class="role-icon">📚</div>
        <div class="role-info">
          <h3>Teacher</h3>
          <p>Manage classes, materials, and students</p>
        </div>
      </div>

      <div class="role-card" onclick="goToLogin('admin')">
        <div class="role-icon">🏫</div>
        <div class="role-info">
          <h3>School Administrator</h3>
          <p>Oversee system, users, and reports</p>
        </div>
      </div>

      <p class="footer-text">LearnNexus v1.0 | Group 2</p>
    </div>

    <!-- PAGE 2: LOGIN -->
    <div id="page-login" style="display: none;">
      <div class="box">
        <div class="selected-role">
          <span id="roleIcon">🎓</span>
          <span id="roleName">Student</span>
        </div>

        <h2>Welcome Back</h2>
        <p class="subtitle">Sign in to continue to your account</p>

        <form onsubmit="event.preventDefault(); alert('Login successful!');">
          <div class="input-group">
            <label>Email Address</label>
            <input type="email" placeholder="Enter your email" required>
          </div>

          <div class="input-group">
            <label>Password</label>
            <div class="password-wrapper">
              <input type="password" id="loginPassword" placeholder="Enter your password" required>
              <button type="button" class="toggle-password" onclick="togglePass('loginPassword', 'eyeIconLogin')">
                <span id="eyeIconLogin">👁️</span>
              </button>
            </div>
            <label class="show-password">
              <input type="checkbox" onclick="togglePass('loginPassword', 'eyeIconLogin')"> Show Password
            </label>
          </div>

          <button type="submit" class="btn-primary">Login</button>
        </form>

        <div class="divider"><span>or</span></div>

        <p class="link-text">
          Don't have an account? <a onclick="showPage('page-register')">Create an Account</a>
        </p>

        <a class="back-link" onclick="showPage('page-role')">← Change Role</a>
      </div>
    </div>

    <!-- PAGE 3: REGISTER -->
    <div id="page-register" style="display: none;">
      <div class="box">
        <h2>Create an Account</h2>
        <p class="subtitle">Join LearnNexus today</p>

        <form onsubmit="event.preventDefault(); alert('Account created successfully!'); showPage('page-login');">
          <div class="input-group">
            <label>Full Name</label>
            <input type="text" placeholder="Enter your full name" required>
          </div>

          <div class="input-group">
            <label>Email Address</label>
            <input type="email" placeholder="Enter your email" required>
          </div>

          <div class="input-group">
            <label>Role</label>
            <select id="registerRole">
              <option value="student">Student</option>
              <option value="teacher">Teacher</option>
              <option value="admin">School Administrator</option>
            </select>
          </div>

          <div class="input-group">
            <label>Password</label>
            <div class="password-wrapper">
              <input type="password" id="regPassword" placeholder="Create a password" required>
              <button type="button" class="toggle-password" onclick="togglePass('regPassword', 'eyeIconReg')">
                <span id="eyeIconReg">👁️</span>
              </button>
            </div>
          </div>

          <div class="input-group">
            <label>Confirm Password</label>
            <div class="password-wrapper">
              <input type="password" id="confirmPassword" placeholder="Confirm your password" required>
              <button type="button" class="toggle-password" onclick="togglePass('confirmPassword', 'eyeIconConfirm')">
                <span id="eyeIconConfirm">👁️</span>
              </button>
            </div>
          </div>

          <label class="terms">
            <input type="checkbox" required> I agree to the <a href="#">Terms and Conditions</a>
          </label>

          <button type="submit" class="btn-primary">Create Account</button>
        </form>

        <p class="link-text">
          Already have an account? <a onclick="showPage('page-login')">Login</a>
        </p>

        <a class="back-link" onclick="showPage('page-role')">← Back to Role Selection</a>
      </div>
    </div>
  </div>

  <script>
    const roleNames = {
      'student': 'Student',
      'teacher': 'Teacher',
      'admin': 'School Administrator'
    };

    const roleIcons = {
      'student': '🎓',
      'teacher': '📚',
      'admin': '🏫'
    };

    let currentRole = 'student';

    function showPage(pageId) {
      document.getElementById('page-role').style.display = 'none';
      document.getElementById('page-login').style.display = 'none';
      document.getElementById('page-register').style.display = 'none';

      document.getElementById(pageId).style.display = 'block';

      if (pageId === 'page-role') {
        document.getElementById('subtitleText').textContent = 'Learning Management System';
      } else {
        document.getElementById('subtitleText').textContent = '';
      }
    }

    function goToLogin(role) {
      currentRole = role;
      document.getElementById('roleIcon').textContent = roleIcons[role];
      document.getElementById('roleName').textContent = roleNames[role];
      document.getElementById('registerRole').value = role;
      showPage('page-login');
    }

    function togglePass(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = '🙈';
      } else {
        input.type = 'password';
        icon.textContent = '👁️';
      }
    }
  </script>
</body>
</html>
